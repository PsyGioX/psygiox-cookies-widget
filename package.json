{
  "name": "psygiox-cookies-widget",
  "version": "1.0.0",
  "description": "PGX Cookies Widget — universal cookie consent with real-time cookie tracking, Cookie Guard, API and Intl-based i18n for the EU, US, Russia and worldwide.",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "ccpa",
    "cpra",
    "152-fz",
    "gpc",
    "consent-mode",
    "cookie-banner",
    "privacy",
    "widget",
    "i18n"
  ],
  "homepage": "https://github.com/PsyGioX/psygiox-cookies-widget#readme",
  "bugs": {
    "url": "https://github.com/PsyGioX/psygiox-cookies-widget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PsyGioX/psygiox-cookies-widget.git"
  },
  "license": "GPL-3.0-only",
  "author": "PsyGioX <https://github.com/PsyGioX>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "config": {
    "siteUrl": "https://psygiox-cookies-widget.vercel.app",
    "released": "2026-10-29"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-site.mjs",
    "build:widget": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "brand": "node scripts/brand.mjs",
    "verify": "node scripts/verify.mjs",
    "headers": "node scripts/check-headers.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run headers && npm run build && npm run verify && npm test",
    "serve": "npx --yes serve ."
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/titan-one": "^5.0.0",
    "@resvg/resvg-js": "^2.6.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^30.1.3",
    "opentype.js": "^1.3.4"
  }
}
